	system("cls");
	
	cout << "\n----------------------------------------------------------------------------------\n";
	cout << "  -                             Welcome to                                         -\n";
	cout << "  ----------------------------------------------------------------------------------\n";
	cout << "                           ********SHOW MENU**********                              \n";
	cout << "\tMilktea and Coffee                                Price\n";
	
	for(int i = 0; i < 5; i++) {
		cout << "\t" << i + 1 << ". " << left << setw(30) << milkteaMenu[i].name;
		cout << right << setw(8) << "M - " << setw(5) << milkteaMenu[i].PriceM;
		cout << right << setw(8) << "L - " << setw(3) << milkteaMenu[i].PriceL << "\n";
	}
	
	for(int i = 0; i < 5; i++) {
		cout << "\t" << i + 6 << ". " << left << setw(30) << coffeeMenu[i].name;
		cout <<  right << setw(8) << "M - " << setw(5) << coffeeMenu[i].PriceM;
		cout <<  right << setw(8) << "L - " << setw(3) << coffeeMenu[i].PriceL<< "\n";
	}
	
	cout << "\n";
	cout << "\t[A] Check Sales\n";
	cout << "\n";
}   

void addOrder(int item, char size, int quantity) {
	int Price;
	
	if(size == 'M') {
		Price = milkteaMenu[item].PriceM;
		Price = coffeeMenu[item].PriceM;
	} else {
	    Price = milkteaMenu[item].PriceL;
		Price = coffeeMenu[item].PriceL;
	}
	
	orders[orderCount].item = item;
	orders[orderCount].size = size;
	orders[orderCount].quantity = quantity;
	orders[orderCount].price = Price * quantity;
	
	orderCount++;
	
}

void showReceipt() {
	double total = 0;
	double cash;
	
	for(int i = 0; i < orderCount; i++) {
		total = total + orders[i].price;
		
		cout << fixed << setprecision(2);
		cout << "\tTotal: " << total << "\n";
	}
	
	do {
		cout << "Enter Cash: ";
		cin >> cash;
		
		if(cash < total) {
			cout << "Invalid Cash!\n";
		  } 
		}while(cash < total);
		
		system("cls");
		cout << "\n----------------------------------------------------------------------------------\n";
	    cout << "  -                             Welcome to                                         -\n";
	    cout << "  ----------------------------------------------------------------------------------\n";
	    cout << left << setw(10) << "Quantity" << setw(28) << "Name" << setw(6) << "Size" << right << setw(7) << "Price";
	    
	    for(int i = 0; i < orderCount; i++) {
	    	cout << left << setw(10) << orders[i].quantity << setw(28) << milkteaMenu[orders[i].item].name << setw(6) << orders[i].size << setw(7) << orders[i].price;
	    	cout << left << setw(10) << orders[i].quantity << setw(28) << coffeeMenu[orders[i].item].name << setw(6) << orders[i].size << setw(7) << orders[i].price;
	    	
	    	if(orders[i].size == 'M') {
	    			milkteaMenu[orders[i].item].PriceM += orders[i].quantity;
	    			coffeeMenu[orders[i].item].PriceM += orders[i].quantity;
			} else {
				milkteaMenu[orders[i].item].PriceM += orders[i].quantity;
				coffeeMenu[orders[i].item].PriceM += orders[i].quantity;
			}
		}
		
			cout << "\n================================================\n";
			cout << left << setw(12) << "Total : " << right << setw(39) << total << "\n";
			cout << left << setw(12) << "Cash  : " << right << setw(39) << cash << "\n";
			cout << left << setw(12) << "Change: " << right << setw(39) << cash - total << "\n";
			cout << "==================================================\n";
			cout << "                THANK YOU FOR BUYING!             \n";
			cout << "                COME AGAIN NEXT TIME!             \n";
    
			
			press1();
	
}

void CheckSales() {
	double totalSales = 0;
	double amount;
	
	system("cls");
	cout << fixed << setprecision(2);
	    cout << "\n----------------------------------------------------------------------------------\n";
	    cout << "  -                             Welcome to                                         -\n";
	    cout << "  ----------------------------------------------------------------------------------\n";
	    cout << left << setw(15) << "Name" << setw(18) << "Quantity" << setw(20) << "Size" << right << setw(22) << "Total" << "\n";
		
		for(int i = 0; i < 5; i++) {
			if(milkteaMenu[i].SoldM > 0 && coffeeMenu[i].SoldM) {
				amount = milkteaMenu[i].SoldM * milkteaMenu[i].PriceM;
				amount = coffeeMenu[i].SoldM * coffeeMenu[i].PriceL;
				
				totalSales = totalSales + amount;
			}
			if(milkteaMenu[i].SoldL > 0 && coffeeMenu[i].SoldL) {
				amount = milkteaMenu[i].SoldL * milkteaMenu[i].PriceL;
				amount = coffeeMenu[i].SoldL * coffeeMenu[i].PriceL;
				
				totalSales = totalSales + amount;
		} 
		
	}
	cout << "===================================================================\n";
	cout << left << setw(12) << "Total Sales: " << right << setw(39) << totalSales << "\n";
	
	press1();
}

void press1() {
	int one;
	
	do {
		cout << "\nPress 1 to go back to main menu.....";
		cin >> one;
	} while(one != 1);
}

