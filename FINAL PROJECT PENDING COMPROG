#include <iostream>
#include <iomanip>
#include <cstdlib>
#include <cctype>
#include <string>
using namespace std;


struct Order {
	int item;
	char size;
	int quantity;
	double price;
};

struct Drink {
	string name;
	int PriceM;
	int PriceL;
	int SoldM;
	int SoldL;
};

Drink milkteaMenu[5] = {
	{"Strawberry Matcha",      60, 85, 0, 0},
	{"Cookies and Cream",      60, 85, 0, 0},
	{"Red Velvet",             60, 85, 0, 0},
	{"Winter Melon",           60, 85, 0, 0},
	{"Dark Chocolate",         60, 85, 0, 0}
	
};

Drink coffeeMenu[5] = {
	{"Americano",         65, 90},
	{"Cappuccino",         65, 90},
	{"Espresso",          65, 90},
	{"Macchiato",         65, 90},
	{"Mocha",             65, 90}
};

Order orders[100];
int orderCount = 0;

void showMenu();
void addOrder(int item, char size, int quantity);
void showReceipt();
void CheckSales();
void press1();

	
int main() {
    char choice, size, add;
    int quantity;

    do {
        showMenu();

        cout << "Enter your Choice: ";
        cin >> choice;
        choice = toupper(choice);

        if(choice == 'A') {
            CheckSales();
        }
        else if(choice < '1' || choice > '5') {
            cout << "Wrong choice!!\n";
            system("pause");
        }
        else {

            do {

                do {
                    cout << "Select Cup size (M/L): ";
                    cin >> size;
                    size = toupper(size);

                    if(size != 'M' && size != 'L') {
                        cout << "Wrong size!\n";
                    }

                } while(size != 'M' && size != 'L');


                do {
                    cout << "Quantity: ";
                    cin >> quantity;

                    if(quantity < 1) {
                        cout << "Invalid Quantity!\n";
                    }

                } while(quantity < 1);


                addOrder(choice - '1', size, quantity);


                do {
                    cout << "Add Order (Y/N): ";
                    cin >> add;
                    add = toupper(add);

                    if(add != 'Y' && add != 'N') {
                        cout << "Please type Y and N only.\n";
                    }

                } while(add != 'Y' && add != 'N');


                if(add == 'Y') {

                    do {
                        cout << "Enter Choice: ";
                        cin >> choice;

                        if(choice < '1' || choice > '5') {
                            cout << "Invalid Choice!!\n";
                        }

                    } while(choice < '1' || choice > '5');

                }

            } while(add == 'Y');

            showReceipt();
        }

    } while(true);

    return 0;
}

