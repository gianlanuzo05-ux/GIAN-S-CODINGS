 			cin >> employees[i].DailyRate;
 			
 			cout << "Enter your New Hours Worked: ";
 			cin >> employees[i].HoursWorked;
 			
 			cout << "Enter your New Gross Pay: ";
 			cin >> employees[i].GrossPay;
 			
 			cout << "Enter your New Net Pay: ";
 			cin >> employees[i].NetPay;
 			
 			cout << "\nEmployee's Update SuccessFully!\n";
 			
 			found = true;
 			break;
 			
		 }
	 } 
	 if(!found) {
	 	cout << "\nEmployee's Not Found!\n";
	 }
 	
 }
 
 void DeleteEmployee() {
 	int searchID;
 	bool found = false;
 	
 	cout << "\n========DELETE EMPLOYEE'S==========\n";
 	
 	cout << "Enter Employee's ID to delete: ";
 	cin >> searchID;
 	
 	for(int i = 0; i < employeeCount; i++) {
 		if(employees[i].id == searchID) {
 			
 			
 			for(int j = i;  j < employeeCount - 1; j++) {
 				employees[j] = employees[j + 1];
			 }
			 
			 employeeCount--;
			 
			 cout << "\nEmployee's Deleted SuccessFully!\n";
			 
			 found = true;
			 break;
		 }
	 }
	 if(!found) {
	 	cout << "\nEmployee's Not Found!\n";
	 }
 }
 
