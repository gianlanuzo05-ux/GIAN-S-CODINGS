 void AddEmployee() {
 	
 	
 	if(employeeCount >= 100) {
 		cout <<"\nEmployee's list is full!\n";
 		return;
	 }
	 
	 cout << "\n==========ADD EMPLOYEE==========\n";
	 
	 cout << "Enter Employee's ID: ";
	 cin >> employees[employeeCount].id;
	 
	 cin.ignore();
	 	 
	 cout << "Enter Employee's Name: ";
	 getline(cin, employees[employeeCount].name);
	 
	 cout << "Enter Employee's Position: ";
	 getline(cin, employees[employeeCount].position);
	
	 
	 cout << "Enter Your Daily Rate: ";
	 cin >> employees[employeeCount].DailyRate;
	 
	 cout << "Enter Your Worked Hours: ";
	 cin >> employees[employeeCount].HoursWorked;
	 
	 cout << "Enter Your Deductions: ";
	 cin >> employees[employeeCount].Deductions;
	 
	 employees[employeeCount].GrossPay = employees[employeeCount].DailyRate * employees[employeeCount].HoursWorked;
	 
	 employees[employeeCount].NetPay = employees[employeeCount].GrossPay - employees[employeeCount].Deductions;
	 
	 employeeCount++;
	 
	 cout << "\nEmployee Added SuccessFully!\n";

 }
 
 void ViewEmployee() {
 	cout << "\n===========VIEW EMPLOYEE'S==============\n";
 	
 	if(employeeCount == 0) {
 		cout << "\nNo Employee's recorded yet\n";
 		return;
	 }
	 
	 for(int i = 0; i < employeeCount; i++) {
		 
	 	cout << "\nEmployee's # " << i + 1 << "\n";
	 	cout << "Employee's ID           : " << employees[i].id << "\n";
	 	cout << "Employee's Name         : " << employees[i].name << "\n";
	 	cout << "Employee's Position     : " << employees[i].position << "\n";
	 	cout << "Employee's Daily Rate   : " << employees[i].DailyRate << "\n";
	 	cout << "Employee's Hours Worked : " << employees[i].HoursWorked << "\n";
	 	cout << "Employee's Gross Pay    : " << employees[i].GrossPay << "\n";
	 	cout << "Employee's Deductions   : " << employees[i].Deductions << "\n";
	 	cout << "Employee's Net Pay      : " << employees[i].NetPay << "\n";

	}
 }
 
 void CalculatePayroll() {
 	cout << "\n=========CALCULATE YOUR PAYROLL=============\n";
 	
 	if(employeeCount == 0) {
 		cout << "\nNo Employee's Recorded Yet!\n";
 		return;
	 }
 	
 	for(int i = 0; i < employeeCount; i++) {
 		
 		employees[i].GrossPay = employees[i].DailyRate * employees[i].HoursWorked;
 		employees[i].NetPay = employees[i].GrossPay - employees[i].Deductions;
 		
 		cout << "Employee's Name         : " << employees[i].name << "\n";
 		cout << "Employee's Daily Rate   : " << employees[i].DailyRate << "\n";
 		cout << "Employee's Hours Worked : " << employees[i].HoursWorked << "\n";
 		cout << "Employee's Gross Pay    : " << employees[i].GrossPay << "\n";
 		cout << "Employee's Net Pay      : " << employees[i].NetPay << "\n";
 		
	 }
 	
 }
 
 void SearchEmployee() {
 	int searchID;
 	bool found = false;
 	
 	cout << "\n==========SEARCH EMPLOYEE'S=============\n";
 	
 	cout << "Enter Employee's ID: ";
 	cin >> searchID;
 	
 	for(int i = 0; i < employeeCount; i++) {
 		if(employees[i].id == searchID) {
 			
 			cout << "\nEmployee's Found!\n";
 			cout << "Employee's ID        : " << employees[i].id << "\n";
	 	    cout << "Employee's Name      : " << employees[i].name << "\n";
	 	    cout << "Employee's Position  : " << employees[i].position << "\n";
	 	    cout << "Employee's Gross Pay : " << employees[i].GrossPay << "\n";
	 	    cout << "Employee's Deductions: " << employees[i].Deductions << "\n";
	 	    cout << "Employee's Net Pay   : " << employees[i].NetPay << "\n";
	 	    
	 	    	found = true;
	 	    	break;
	 	    	
		 }
	 }
	 if(!found) {
	 	cout << "\nEmployee's Not Found!\n";
	 }
 }
 
 void UpdateEmployee() {
 	int searchID;
 	bool found = false;
 	
 	cout << "\n===========UPDATE EMPLOYEE'S=============\n";
 	
 	cout << "Enter Employee's ID: ";
 	cin >> searchID;
 	
 	for(int i = 0; i < employeeCount; i++) {
 		if(employees[i].id == searchID) {
 			cout << "\nEmployee's Found!\n";
 			
 			cin.ignore();
 			
 			cout << "Enter your New Name: ";
 			getline(cin, employees[i].name);
 			
 			cout << "Enter your New Position: ";
