	cout << "B. Socrates\n";
	cout << "C. Deniss Ritchie\n";
	cout << "D. Vice Ganda\n";
	
	cout << "Enter your answer: ";
	cin >> answer;
	
	if(answer ==  'A' || answer == 'a') {
		cout << "Correct!\n";
		score++;
	} else {
		cout << "Wrong answer! the answer is A\n";
	}
	
	cout << "4. What data types storing 15 decimal digits?\n";
	cout << "A. string\n";
	cout << "B. int\n";
	cout << "C. Double\n";
	cout << "D. Float\n";
	
	cout << "Enter your answer: ";
	cin >> answer;
	
	if(answer == 'C' || answer == 'c') {
		cout << "Correct!\n";
		score++;
	} else {
		cout << "Wrong answer! the answer is C\n";
	}
	
