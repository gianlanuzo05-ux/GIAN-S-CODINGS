	if(answer == 'D' || answer == 'd') {
		cout << "Correct!\n";
		score++;
	} else {
		cout << "Wrong answer! the answer is D";
	}
	
	
	average = (score * 100) / item;
	
	
	if(average >= 80) {
		cout << "Well done! Outstanding Performance!\n";
	}
	else if(average >= 60) {
		cout << "Good performance!\n";
	}
	else if(average >= 40) {
